  {
    "start": "00:02:00.400",
    "end": "00:02:03.430",
    "start_seconds": 120.4,
    "end_seconds": 123.43,
    "text": "the NM ROM is currently slower than the"
  },
  {
    "start": "00:02:03.430",
    "end": "00:02:03.440",
    "start_seconds": 123.43,
    "end_seconds": 123.44,
    "text": "the NM ROM is currently slower than the"
  },
  {
    "start": "00:02:03.440",
    "end": "00:02:05.070",
    "start_seconds": 123.44,
    "end_seconds": 125.07,
    "text": "the NM ROM is currently slower than the full order model, which is not"
