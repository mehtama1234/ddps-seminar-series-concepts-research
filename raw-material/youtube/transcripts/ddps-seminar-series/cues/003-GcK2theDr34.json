    "start": "00:01:37.750",
    "end": "00:01:37.760",
    "start_seconds": 97.75,
    "end_seconds": 97.75999999999999,
    "text": "intrusive."
  },
  {
    "start": "00:01:37.760",
    "end": "00:01:39.950",
    "start_seconds": 97.75999999999999,
    "end_seconds": 99.95,
    "text": "intrusive. Roughly speaking, more intrusiveness"
