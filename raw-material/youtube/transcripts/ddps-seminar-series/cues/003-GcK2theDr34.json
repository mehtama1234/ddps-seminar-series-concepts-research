  {
    "start": "00:01:56.430",
    "end": "00:01:56.440",
    "start_seconds": 116.43,
    "end_seconds": 116.44,
    "text": "surrogate model that is NM ROM."
  },
  {
    "start": "00:01:56.440",
    "end": "00:02:00.390",
    "start_seconds": 116.44,
    "end_seconds": 120.39,
    "text": "surrogate model that is NM ROM. Unfortunately,"
